# 서버의 /opt/tukfit/.env 로 복사해서 채운다. 이 파일(.env)은 절대 커밋하지 않는다.
# 비어 있는 값은 "나중에 붙이면 되는" 항목이다. 비어 있어도 서비스는 뜬다.

# ── 사이트 ──────────────────────────────────────────────
# 도메인 연결 전에는 SITE_URL=http://<서버 IP>, DOMAIN은 비워 둔다.
SITE_URL=http://123.123.123.123
DOMAIN=
# HTTPS 적용 후 true로 바꾼다 (HTTP에서 true면 로그인 쿠키가 동작하지 않음)
COOKIE_SECURE=false

# ── 이미지 태그 (배포 스크립트가 덮어씀) ─────────────────
GHCR_OWNER=jngbnss
IMAGE_TAG=latest

# ── DB (컨테이너 내부 전용) ─────────────────────────────
POSTGRES_DB=tukfit
POSTGRES_USER=tukfit
POSTGRES_PASSWORD=change-me-long-random

# ── 보안 ────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=change-me
# 서버가 처음 뜰 때 이 계정으로 관리자를 만든다 (비밀번호 10자 이상)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── 이미지 저장소 (Cloudflare R2) ───────────────────────
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=tukfit
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 버킷의 공개 주소 (R2 public bucket URL 또는 연결한 이미지 도메인)
S3_PUBLIC_BASE_URL=
S3_PATH_STYLE=true

# ── 결제 (PG 계약 후) ───────────────────────────────────
# MOCK: 가짜 결제. 실제 판매 전에 반드시 TOSS로 바꾼다.
PAYMENT_PROVIDER=MOCK
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 소셜 로그인 (각 개발자 콘솔에 앱 등록 후) ───────────
# Redirect URI: ${SITE_URL}/login/oauth2/code/kakao , .../naver
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 메일 (비밀번호 재설정). 비우면 링크를 로그로만 남김 ──
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── DB 백업 업로드 대상 (R2 버킷, 비우면 서버에만 보관) ──
BACKUP_S3_BUCKET=
